{
    "app_name": "Univer",
    "version": "v0.1.5",
    "language": "Python",
    "os": "Windows",
    "license": "MIT",
    "logging": {
        "level": "INFO",
        "log_dir": "logs",
        "log_file": "univer.log",
        "max_bytes": 1048576,
        "backup_count": 5,
        "console": true,
        "format": "%(asctime)s [%(levelname)s] %(name)s: %(message)s",
        "datefmt": "%Y-%m-%d %H:%M:%S"
    }
}
